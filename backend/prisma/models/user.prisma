model User {
  id           String   @id @default(ulid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart        Cart?
  orders      Order[]
  memberships UserMembership[]
  payments    Payment[]
  invoices    Invoice[]

  attendances        Attendance[] @relation("AttendanceUser")
  attendancesScanned Attendance[] @relation("AttendanceScannedBy")
}

enum Role {
  USER
  ADMIN
  BACKOFFICE
}