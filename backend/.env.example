PORT=8001

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"

JWT_SECRET="change-me"

# Optional: your frontend URL (used for OAuth redirect)
# WEB_URL=http://localhost:5173

# Optional: cookie config (used by OAuth state/PKCE cookies)
# For local HTTP dev, keep this false. For production HTTPS, set true.
# COOKIE_SECURE=false

# Optional: OTP config (defaults: secret=JWT_SECRET, ttl=10m, cooldown=60s, maxAttempts=5)
# OTP_SECRET="change-me-too"
# OTP_TTL_MINUTES=10
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_ATTEMPTS=5

# Optional: SMTP (if not set, OTP code will be logged to console)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Risefit <no-reply@risefit.local>"

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback

# Optional: Apple OAuth
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Or provide base64-encoded DER (PKCS#8) via:
APPLE_PRIVATE_KEY_BASE64=
APPLE_REDIRECT_URI=http://localhost:8000/auth/oauth/apple/callback

# Optional: bcrypt config
# BCRYPT_SALT_ROUNDS=10

# Optional: CORS (default allow localhost + 127.0.0.1)
CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# Optional: enforce location radius for attendance scan
# GYM_LAT=-6.2088
# GYM_LNG=106.8456
# GYM_RADIUS_METERS=200

MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false
